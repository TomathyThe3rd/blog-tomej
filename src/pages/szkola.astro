---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pl">
	<head>
		<BaseHead title={`Szkoła | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 720px; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Szkoła</h1>
			<p>Tu opiszesz, czym się zajmujesz, jaki kierunek, jakie przedmioty Cię interesują, co robisz poza zajęciami.</p>

			<h2>Kierunek</h2>
			<p>Nazwa kierunku, uczelnia/technikum, rok.</p>

			<h2>Zainteresowania</h2>
			<p>Co Cię kręci w nauce, jakie projekty robisz w ramach zajęć.</p>
		</main>
		<Footer />
	</body>
</html>