---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pl">
	<head>
		<BaseHead title={`Szkoła | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 720px; }
			.pusto { color: rgb(var(--gray)); font-style: italic; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Szkoła</h1>
			<p class="pusto">Tutaj kiedyś się rozpiszę.</p>
		</main>
		<Footer />
	</body>
</html>