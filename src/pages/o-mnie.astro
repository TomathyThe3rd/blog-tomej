---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pl">
	<head>
		<BaseHead title={`O mnie | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 720px; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>O mnie</h1>
			<p>Cześć, jestem Tomasz. Tu kilka słów o sobie — czym się zajmuję, co lubię, czym się interesuję.</p>

			<h2>Kontakt</h2>
			<p>Mail: <a href="mailto:twoj@email.com">twoj@email.com</a></p>
			<p>GitHub: <a href="https://github.com/twoj-user">github.com/twoj-user</a></p>
		</main>
		<Footer />
	</body>
</html>