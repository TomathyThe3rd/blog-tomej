---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				padding-top: 1.5rem;
			}
			.hero {
				text-align: center;
				padding: 0.5rem 0 0.5rem;
			}
			.hero h1 {
				font-size: 1.9rem;
				margin: 0 0 0.5rem;
				line-height: 1.2;
			}
			.hero p {
				color: rgb(var(--gray));
				font-size: 1rem;
				margin: 0;
			}
			.guestbook {
				margin-top: 1.25rem;
				text-align: center;
				border-top: 1px solid rgb(var(--gray-light));
				padding-top: 1rem;
			}
			.guestbook p {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				margin: 0 0 0.4rem;
			}
			.guestbook a {
				display: inline-block;
				font-size: 1.25rem;
				font-weight: 700;
				color: rgb(var(--accent));
				text-decoration: none;
				border-bottom: 3px solid transparent;
				padding-bottom: 2px;
				transition: border-color 0.15s ease;
			}
			.guestbook a:hover {
				border-bottom-color: rgb(var(--accent));
			}
			.sekcje {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 0.6rem;
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 0;
			}
			.sekcje li {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 0.75rem 0.9rem;
				transition: 0.2s ease;
			}
			.sekcje li:hover {
				border-color: rgb(var(--accent));
				transform: translateY(-2px);
			}
			.sekcje a {
				text-decoration: none;
				display: block;
			}
			.sekcje h2 {
				margin: 0 0 0.2rem;
				font-size: 1rem;
			}
			.sekcje p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.8rem;
				line-height: 1.35;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Witaj na stronie najpopularniejszego biseksa w 4INF</h1>
			</div>

			<div class="guestbook">
				<p>Najważniejsza część strony jest poniżej</p>
				<a href="https://guests.tomej.xyz">Księga gości →</a>
			</div>

			<ul class="sekcje">
				<li>
					<a href="/blog">
						<h2>Blog</h2>
						<p>Ogólne wpisy i przemyślenia.</p>
					</a>
				</li>
				<li>
					<a href="/sport">
						<h2>Sport</h2>
						<p>Treningi, starty, relacje.</p>
					</a>
				</li>
				<li>
					<a href="/projekty">
						<h2>Projekty</h2>
						<p>Devlog — co robię, na jakim etapie.</p>
					</a>
				</li>
				<li>
					<a href="/muzyka">
						<h2>Muzyka</h2>
						<p>Recenzje, przemyślenia, ulubione utwory.</p>
					</a>
				</li>
				<li>
					<a href="/osiagniecia">
						<h2>Osiągnięcia</h2>
						<p>Lista rzeczy, które udało się zrobić.</p>
					</a>
				</li>
				<li>
					<a href="/szkola">
						<h2>Szkoła</h2>
						<p>Czym się zajmuję poza zajęciami.</p>
					</a>
				</li>
				<li>
					<a href="/o-mnie">
						<h2>O mnie</h2>
						<p>Kilka słów o sobie i kontakt.</p>
					</a>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>