---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pl">
	<head>
		<BaseHead title={`404 — Nie znaleziono | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				text-align: center;
				padding: 4rem 1.5rem;
			}
			h1 {
				font-size: 5rem;
				margin: 0 0 1rem;
				line-height: 1;
				color: rgb(var(--accent));
			}
			p {
				color: rgb(var(--gray));
				font-size: 1.1rem;
				margin: 0 0 2rem;
			}
			a {
				display: inline-block;
				padding: 0.75rem 1.5rem;
				background: rgb(var(--accent));
				color: white;
				text-decoration: none;
				border-radius: 8px;
				font-weight: 500;
				transition: opacity 0.15s ease;
			}
			a:hover {
				opacity: 0.85;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>404</h1>
			<p>Ta strona nie istnieje. Może kiedyś istniała, może nigdy nie będzie. Ale spokojnie — wróć na główną.</p>
			<a href="/">← Powrót do strony głównej</a>
		</main>
		<Footer />
	</body>
</html>