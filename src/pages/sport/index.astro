---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('sport')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pl">
	<head>
		<BaseHead title={`Sport | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; }
			ul { list-style: none; padding: 0; }
			ul li { margin-bottom: 2rem; }
			.title { margin: 0; }
			.date { margin: 0; color: rgb(var(--gray)); font-size: 0.875rem; }
			.meta { margin: 0; color: rgb(var(--gray)); font-size: 0.875rem; }
			a { text-decoration: none; }
			a:hover .title { color: rgb(var(--accent)); }
			.pusto { color: rgb(var(--gray)); font-style: italic; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Sport</h1>
			{posts.length === 0 ? (
				<p class="pusto">Posty nadchodzą. Zajrzyj tu wkrótce.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/sport/${post.id}/`}>
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								{(post.data.dyscyplina || post.data.dystans || post.data.czas) && (
									<p class="meta">
										{post.data.dyscyplina}
										{post.data.dystans && ` — ${post.data.dystans}`}
										{post.data.czas && ` — ${post.data.czas}`}
									</p>
								)}
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>