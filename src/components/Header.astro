---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/sport">Sport</HeaderLink>
			<HeaderLink href="/projekty">Projekty</HeaderLink>
			<HeaderLink href="/muzyka">Muzyka</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/osiagniecia">Osiągnięcia</HeaderLink>
			<HeaderLink href="/szkola">Szkoła</HeaderLink>
			<HeaderLink href="/o-mnie">O mnie</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		/* UŻYWAMY rgb() WOKÓŁ ZMIENNEJ */
		background: rgb(var(--bg-elevated));
		border-bottom: 1px solid rgb(var(--border));
	}

	h2 {
		margin: 0;
		font-size: 1.1em;
	}

	h2 a {
		text-decoration: none;
		color: rgb(var(--text));
		font-weight: 700;
	}

	h2 a:hover {
		color: rgb(var(--accent));
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5em;
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--text-muted));
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
		transition: color 0.2s ease; /* Dodane dla płynności */
	}

	/* TU JEST NAPRAWA HOVERA */
	nav a:hover {
		color: rgb(var(--accent)) !important; /* Podświetlenie na czerwono */
		border-bottom-color: rgb(var(--accent)); /* Opcjonalna kreska na dole przy najechaniu */
	}

	nav a.active {
		color: rgb(var(--text));
		border-bottom-color: rgb(var(--accent));
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
		}
		.internal-links {
			width: 100%;
			overflow-x: auto;
		}
		nav a {
			padding: 0.75em 0.5em;
			font-size: 0.9em;
		}
	}
</style>