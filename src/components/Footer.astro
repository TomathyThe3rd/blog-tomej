---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} Tomasz Książek. Wszelkie prawa zastrzeżone.</p>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		/* Używamy zmiennej bg-elevated, żeby stopka była jaśniejsza od tła strony */
		background-color: rgb(var(--bg-elevated)); 
		color: rgb(var(--text-muted)); /* Delikatnie przygaszony tekst */
		margin-top: auto;
		border-top: 1px solid rgb(var(--border)); /* Linia oddzielająca, jak w headerze */
	}

	.footer-content {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 2rem 1rem;
		text-align: center;
		font-size: 0.9rem;
	}

	p {
		margin: 0;
	}
</style>