---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} Tomasz Książek. Wszelkie prawa zastrzeżone.</p>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		background-color: rgb(var(--black)); /* Kolor tła taki jak w headerze */
		color: rgb(var(--gray)); /* Kolor tekstu taki jak w headerze */
		margin-top: auto; /* Dopychanie stopki do samego dołu ekranu */
	}

	.footer-content {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1rem;
		text-align: center;
		font-size: 0.9rem;
	}

	p {
		margin: 0;
	}
</style>